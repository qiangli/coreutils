#!/bin/sh
# pre-push — cross-OS vet gate. The CI windows leg is the product; this
# catches its compile breaks (unix-only types in untagged files) BEFORE the
# push instead of 10 minutes after. Install once per clone:
#   git config core.hooksPath scripts/hooks
# Bypass in an emergency with: git push --no-verify
#
# The gate itself lives in scripts/crossvet.sh — the SAME script DAG.md's
# `crossvet` task runs, so the hook and `bashy dag crossvet` can never check
# different target lists. Do not inline the loop here again.
set -e
exec "$(git rev-parse --show-toplevel)/scripts/crossvet.sh"
