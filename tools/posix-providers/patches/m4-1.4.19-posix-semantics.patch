-  sigaction (SIGSEGV, &act, NULL);
-  sigaction (SIGABRT, &act, NULL);
-  sigaction (SIGILL, &act, NULL);
-  sigaction (SIGFPE, &act, NULL);
-  sigaction (SIGBUS, &act, NULL);
-  if (c_stack_action (fault_handler) == 0)
-    nesting_limit = 0;
+  /* This binary is built solely as Bashy's POSIX provider.  Preserve every
+     inherited signal disposition and leave default actions to the kernel, as
+     required by the utility's ASYNCHRONOUS EVENTS contract.  */
