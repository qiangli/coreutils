diff --git a/src/input.c b/src/input.c
index 727ac7f..f1c6676 100644
--- a/src/input.c
+++ b/src/input.c
@@ -412,0 +413,16 @@ pop_wrapup (void)
+  /* POSIX requires repeated m4wrap calls to be processed in call order.
+     GNU mode deliberately retains its historical stack order.  */
+  if (no_gnu_extensions)
+    {
+      input_block *previous = NULL;
+      input_block *current = wsp;
+      while (current != NULL)
+        {
+          input_block *following = current->prev;
+          current->prev = previous;
+          previous = current;
+          current = following;
+        }
+      wsp = previous;
+    }
+
diff --git a/src/m4.c b/src/m4.c
index 2bd5775..eb6df17 100644
--- a/src/m4.c
+++ b/src/m4.c
@@ -390,0 +391,18 @@ process_file (const char *name)
+/* Return true when ARG names a POSIX macro.  A definition may contain an
+   equals sign followed by its value; an undefinition may not.  Keep this
+   byte-oriented, like the default input lexer in input.c.  */
+static bool
+valid_posix_macro_name (const char *arg, bool definition)
+{
+  const unsigned char *p = (const unsigned char *) arg;
+
+  if (!(('A' <= *p && *p <= 'Z') || ('a' <= *p && *p <= 'z') || *p == '_'))
+    return false;
+  p++;
+  while (('A' <= *p && *p <= 'Z') || ('a' <= *p && *p <= 'z')
+         || ('0' <= *p && *p <= '9') || *p == '_')
+    p++;
+
+  return *p == '\0' || (definition && *p == '=');
+}
+
